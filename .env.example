# Servidor
PORT=3000

# Secreto compartido para proteger /internal/* (llamado por Make.com)
INTERNAL_JOBS_SECRET=

# Anthropic (Claude) - loop de tool-use de WhatsApp y simulador de llamadas
ANTHROPIC_API_KEY=

# --- MULTI-RESTAURANTE ---
# Base central del Registro (tablas Restaurantes y Usuarios).
# Cada restaurante tiene ADEMÁS su propia base, referenciada desde ahí.
REGISTRO_BASE_ID=

# Firma de las sesiones del panel (JWT). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=

# Cifrado de las credenciales que cada restaurante guarda desde el panel
# (auth token de Twilio, API key de Vapi). Generar igual que el anterior.
# OJO: si se cambia, los secretos guardados dejan de poder descifrarse y hay
# que volver a pegarlos en la pestaña Configuración.
TENANT_SECRETS_KEY=

# Airtable: Personal Access Token con scopes data.records:read/write,
# schema.bases:read y acceso a TODAS las bases (Registro + restaurantes).
# Para dar de alta locales por script hace falta también workspacesAndBases:write.
AIRTABLE_API_KEY=
# Workspace donde se crean las bases de los restaurantes nuevos
AIRTABLE_WORKSPACE_ID=

# --- Credenciales CENTRALES de canales (fallback) ---
# Cada restaurante puede poner las suyas en la pestaña Configuración; si no lo
# hace, se usan estas. Útil en sandbox, donde un único número sirve a todos.

# Twilio (WhatsApp Business API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Número de staff por defecto para transferToHuman (formato whatsapp:+34...)
STAFF_WHATSAPP_NUMBER=

# Vapi (voz)
VAPI_PRIVATE_API_KEY=
VAPI_WEBHOOK_SECRET=

# URL pública del backend, una vez desplegado (Railway/Render).
# Se usa en las tools del assistant de Vapi y en el webhook de WhatsApp.
PUBLIC_BASE_URL=

# Enlace de reseña de Google por defecto (cada local puede tener el suyo)
GOOGLE_REVIEW_URL=

# Base de datos principal (sustituye a Airtable)
# La clave debe poder saltarse la proteccion de filas: la app necesita leer y
# escribir reservas de todos sus restaurantes. NUNCA la clave publica.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
